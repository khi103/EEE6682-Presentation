# Veusz saved document: P3 behavioral outputs, not paper measurements

# Keep this file beside its CSV files, then open in Veusz.

ImportFileCSV('tap_tradeoff.csv',linked=True)

ImportFileCSV('alpha_sweep.csv',linked=True)

ImportFileCSV('channel_loss.csv',linked=True)
ImportFileCSV('eye_overlay.csv',linked=True)

Add('page',name='TapVsSwing',autoadd=False)
To('TapVsSwing')
Add('graph',name='graph1',autoadd=False)
To('graph1')
Add('axis',name='x',autoadd=False)
To('x')
Set('label','TX FFE tap count')
Set('min',0)
Set('max',10)
To('..')
Add('axis',name='y',autoadd=False)
To('y')
Set('label','Long-run DC swing (mVpp)')
Set('direction','vertical')
Set('min',0)
Set('max',260)
To('..')
Add('xy',name='series1',autoadd=False)
To('series1')
Set('xData','tap_count')
Set('yData','dc_swing_mVpp')
Set('key','Modeled TX swing')
Set('PlotLine/color','#234D71')
Set('marker','circle')
To('..')
Add('key',name='key1',autoadd=False)
To('key1')
Set('Border/hide',True)
To('..')
To('..')
To('..')

