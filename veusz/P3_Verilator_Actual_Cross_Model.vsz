# Veusz graph of executed original and P3-modified lecturer Verilator data
# Different bit rates/channels: NEVER compare magnitudes as a direct performance ranking.
ImportFileCSV('../results/verilator/verilator_original_56G_taps.csv',linked=True,dsprefix='orig_')
ImportFileCSV('../results/verilator/verilator_P3_3p6G_taps.csv',linked=True,dsprefix='p3_')
Add('page',name='Original56Gbps',autoadd=False)
To('Original56Gbps')
Add('graph',name='graph1',autoadd=False)
To('graph1')
Add('axis',name='x',autoadd=False)
To('x')
Set('label','Original lecture TX FFE tap count at 56Gb/s')
To('..')
Add('axis',name='y',autoadd=False)
To('y')
Set('label','Worst-case Eye Height (mV)')
Set('direction','vertical')
To('..')
Add('xy',name='original_eye',autoadd=False)
To('original_eye')
Set('xData','orig_tap_count')
Set('yData','orig_eye_height_mV')
Set('marker','circle')
Set('key','Exact original lecturer 56Gb/s FFE')
To('..')
To('..')
To('..')
Add('page',name='ModifiedP3_3p6Gbps',autoadd=False)
To('ModifiedP3_3p6Gbps')
Add('graph',name='graph1',autoadd=False)
To('graph1')
Add('axis',name='x',autoadd=False)
To('x')
Set('label','TX FFE taps, adapted 3.6Gb/s')
To('..')
Add('axis',name='y',autoadd=False)
To('y')
Set('label','Worst-case Eye Height (mV)')
Set('direction','vertical')
To('..')
Add('xy',name='modified_eye',autoadd=False)
To('modified_eye')
Set('xData','p3_tap_count')
Set('yData','p3_eye_height_mV')
Set('marker','circle')
Set('key','Modified lecture Verilator')
To('..')
To('..')
To('..')
