# Veusz project for the independent DB HiTek 0.18-um NMOS driver reconstruction.
# Generated numerical data, NOT original 2004 silicon measurements.
# Place this file in veusz/ and retain results/spice/p3_segmented_driver/
# in the repository so that the relative linked CSV path resolves.
ImportFileCSV('../results/spice/p3_segmented_driver/tt_code_sweep.csv',linked=True)

Add('page',name='LoadedOutputLevels',autoadd=False)
To('LoadedOutputLevels')
Add('graph',name='graph1',autoadd=False)
To('graph1')
Add('axis',name='x',autoadd=False)
To('x')
Set('label','4-bit segmented driver code')
Set('min',0)
Set('max',15)
To('..')
Add('axis',name='y',autoadd=False)
To('y')
Set('label','Loaded TX output voltage (V)')
Set('direction','vertical')
To('..')
Add('xy',name='MOS_output',autoadd=False)
To('MOS_output')
Set('xData','code')
Set('yData','vout_V')
Set('key','Reconstructed MOS TX')
Set('marker','circle')
Set('PlotLine/color','#245d81')
To('..')
Add('xy',name='Ideal_output',autoadd=False)
To('Ideal_output')
Set('xData','code')
Set('yData','ideal_loaded_V')
Set('key','Ideal 250 mVpp reference')
Set('marker','none')
Set('PlotLine/color','#bc7447')
To('..')
Add('key',name='key1',autoadd=False)
To('key1')
Set('Border/hide',True)
To('..')
To('..')
To('..')

Add('page',name='OutputResistance',autoadd=False)
To('OutputResistance')
Add('graph',name='graph1',autoadd=False)
To('graph1')
Add('axis',name='x',autoadd=False)
To('x')
Set('label','4-bit segmented driver code')
Set('min',0)
Set('max',15)
To('..')
Add('axis',name='y',autoadd=False)
To('y')
Set('label','Incremental output resistance at VREF (ohm)')
Set('direction','vertical')
To('..')
Add('xy',name='Rout',autoadd=False)
To('Rout')
Set('xData','code')
Set('yData','rout_ohm_at_vref')
Set('key','TT, calibrated NMOS output')
Set('PlotLine/color','#236f93')
Set('marker','circle')
To('..')
To('..')
To('..')

Add('page',name='DriverSignalPower',autoadd=False)
To('DriverSignalPower')
Add('graph',name='graph1',autoadd=False)
To('graph1')
Add('axis',name='x',autoadd=False)
To('x')
Set('label','4-bit segmented driver code')
Set('min',0)
Set('max',15)
To('..')
Add('axis',name='y',autoadd=False)
To('y')
Set('label','0.5-V signaling supply DC power (mW); not full link')
Set('direction','vertical')
To('..')
Add('xy',name='Power',autoadd=False)
To('Power')
Set('xData','code')
Set('yData','p_signal_supply_mW')
Set('key','Reconstructed driver, TT 27 C')
Set('PlotLine/color','#9a4c3b')
Set('marker','circle')
To('..')
To('..')
To('..')
